POSTGRES_DB=elowen
POSTGRES_USER=elowen
POSTGRES_PASSWORD=elowen
ELOWEN_DATABASE_URL=postgres://elowen:elowen@localhost:5432/elowen
ELOWEN_NATS_URL=nats://localhost:4222
ELOWEN_API_URL=http://localhost:8080
ELOWEN_NOTES_URL=http://localhost:8081
ELOWEN_LOG_FORMAT=json
ELOWEN_DEVICE_ID=elowen-primary
ELOWEN_DEVICE_NAME=Elowen Primary Workspace
ELOWEN_DEVICE_PRIMARY=true
# Optional explicit overlay for always-allowed repo names.
ELOWEN_ALLOWED_REPOS=elowen-api,elowen-ui,elowen-edge,elowen-notes,elowen-platform
# Preferred parent-directory discovery roots for the edge.
ELOWEN_ALLOWED_REPO_ROOTS=/workspace
# Optional comma-separated subpaths under the trusted roots to skip during discovery.
ELOWEN_REPO_SCAN_EXCLUDE_PATHS=
# Optional comma-separated repo names to hide from orchestrator selection UX.
ELOWEN_HIDDEN_REPOS=
ELOWEN_DEVICE_CAPABILITIES=codex,git,build,test
ELOWEN_EDGE_WORKSPACE_ROOT=/workspace
ELOWEN_EDGE_WORKTREE_ROOT=/workspace/.elowen/worktrees
ELOWEN_SIMULATED_RUN_MS=1500
ELOWEN_VALIDATION_TIMEOUT_SECS=600
ELOWEN_CODEX_COMMAND=
ELOWEN_CODEX_ARGS_JSON=[]
ARANGO_ROOT_PASSWORD=elowen
ELOWEN_ARANGODB_URL=http://localhost:8529
ELOWEN_ARANGODB_DATABASE=elowen_notes
ELOWEN_ARANGODB_USERNAME=root
ELOWEN_ARANGODB_PASSWORD=elowen
ELOWEN_UI_AUTH_CONFIG_PATH=
ELOWEN_UI_PASSWORD=
ELOWEN_UI_OPERATOR_LABEL=Operator
ELOWEN_UI_COOKIE_NAME=elowen_session
ELOWEN_UI_COOKIE_SECURE=false
ELOWEN_UI_SESSION_DAYS=14
